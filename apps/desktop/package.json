{
  "name": "@loc-studio/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "loc-studio デスクトップ版（Electron の殻）",
  "author": "loc-studio",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "electron .",
    "stage": "node scripts/stage-server.mjs",
    "dist": "npm run build && npm run stage && electron-builder",
    "dist:dir": "npm run build && npm run stage && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.loc-studio.desktop",
    "productName": "loc-studio",
    "directories": { "output": "release", "buildResources": "build-resources" },
    "files": ["dist/**/*", "package.json"],
    "asar": true,
    "extraResources": [
      { "from": "build/server", "to": "server", "filter": ["**/*", "**/node_modules/**"] },
      { "from": "resources/watchdog.cjs", "to": "watchdog.cjs" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] },
        { "target": "dir", "arch": ["x64"] }
      ]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": [{ "target": "dmg" }], "category": "public.app-category.developer-tools" },
    "linux": { "target": [{ "target": "AppImage" }], "category": "Development" }
  }
}
