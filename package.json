{
  "name": "loc-studio",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc --noEmit -p apps/web",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:mutation": "node scripts/mutation-check.mjs",
    "cli": "node apps/cli/dist/index.js",
    "dev:web": "npm run dev -w @loc-studio/web",
    "build:web": "tsc -b && npm run build -w @loc-studio/web",
    "start:web": "npm run start -w @loc-studio/web",
    "smoke:web": "node apps/web/scripts/smoke.mjs",
    "check:browser": "node apps/web/scripts/browser-check.mjs",
    "build:desktop": "npm run build -w @loc-studio/desktop",
    "start:desktop": "npm run start -w @loc-studio/desktop",
    "dist:desktop": "npm run dist -w @loc-studio/desktop",
    "check:desktop": "node apps/desktop/scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
